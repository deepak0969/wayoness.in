    /* =========================================================================
       18. MODAL HELPERS, RENDER DISPATCH & PUBLIC BRIDGE
       ========================================================================= */
    function openModal(html) {
      const root = document.getElementById("modal-root");
      if (root) root.innerHTML = html;
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      const root = document.getElementById("modal-root");
      if (root) root.innerHTML = "";
      state.inspectKycUid = null;
      state.inspectTradeId = null;
      state.inspectUserUid = null;
      document.body.style.overflow = "";
    }

    function renderApp() {
      const shell = document.getElementById("console-shell");
      if (!shell) return;
      shell.innerHTML = state.unlocked ? renderConsoleShell() : renderLockScreen();
    }

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (state.confirmDialog) closeConfirm();
        else if (state.lightbox.open) closeLightbox();
        else if (document.getElementById("modal-root")?.innerHTML.trim()) closeModal();
      }
    });

    window.admin = {
      googleSignIn: handleGoogleAdminSignIn,
      setPinDraft(v) { state.pinInput = v; },
      unlockPin: unlockWithPin,
      lock: lockConsole,
      toggleSidebar() { state.sidebarCollapsed = !state.sidebarCollapsed; renderApp(); },
      toggleConnTooltip() { state.showConnTooltip = !state.showConnTooltip; renderApp(); },
      setTab(tab) { state.tab = tab; state.showConnTooltip = false; renderApp(); window.scrollTo({ top: 0, behavior: "smooth" }); },

      // Sample toggle
      loadSampleCases,
      toggleSampleCases() { if (state.sampleMode) clearSampleCases(); else loadSampleCases(); },

      // KYC Desk
      setKycFilter(f) { state.kycFilter = f; renderApp(); },
      setKycSearch(v) { state.kycSearch = v; renderApp(); },
      openKycInspect: openKycInspectModal,
      setRejectDraft(v) { state.kycRejectReasonDraft = v; },
      fillRejectReason(txt) {
        state.kycRejectReasonDraft = txt;
        const el = document.getElementById("kyc-reject-reason");
        if (el) el.value = txt;
      },
      approveKyc,
      rejectKyc,
      confirmApproveKyc(uid) {
        const k = getAllKycRecords().find(x => x.uid === uid);
        openConfirm({
          title: "Approve National ID?",
          message: `Mark ${k?.fullName || uid} as Verified Trader immediately? This syncs live to their Wayones account.`,
          confirmLabel: "Approve ✓",
          confirmTone: "mint",
          onConfirm: () => approveKyc(uid)
        });
      },

      // Disputes & Arbitration
      setDisputeFilter(f) { state.disputeFilter = f; renderApp(); },
      openTradeInspect: renderTradeInspectModal,
      sendArbChat: sendArbitratorMessage,
      executeVerdict: executeDisputeVerdict,
      confirmVerdict(tradeId, verdict) {
        const isRelease = verdict === "release_buyer";
        openConfirm({
          title: isRelease ? "Release Crypto to Buyer?" : "Refund Crypto to Seller?",
          message: isRelease
            ? `This binding ruling completes trade ${tradeId} and credits escrowed crypto to the Buyer.`
            : `This binding ruling cancels trade ${tradeId} and returns escrowed crypto to the Seller.`,
          confirmLabel: isRelease ? "Release to Buyer" : "Refund Seller",
          confirmTone: isRelease ? "mint" : "coral",
          onConfirm: () => executeDisputeVerdict(tradeId, verdict)
        });
      },

      // Users & Risk Control
      setUserSearch(v) { state.userSearch = v; renderApp(); },
      openUserDrawer: renderUserDrawer,
      adjustBalance: adjustUserBalance,
      submitCustomBalance(e, uid) {
        e.preventDefault();
        const coin = document.getElementById("bal-coin")?.value || "USDT";
        const delta = parseFloat(document.getElementById("bal-delta")?.value);
        if (isNaN(delta) || delta === 0) { toast("Enter a non-zero number.", "warning"); return; }
        adjustUserBalance(uid, coin, delta);
      },
      toggleMerchant(uid) { toggleUserFlag(uid, "verifiedMerchant"); },
      toggleSuspend(uid) {
        const u = getAllUsers().find(x => x.uid === uid);
        const reason = document.getElementById("suspend-reason-inp")?.value?.trim() || "Compliance & Risk Review";
        openConfirm({
          title: u?.suspended ? "Reinstate User Account?" : "Suspend User Account?",
          message: u?.suspended
            ? `Restore full trading access for ${u.name}?`
            : `Block trading and flag ${u?.name} as Suspended? Reason: ${reason}`,
          confirmLabel: u?.suspended ? "Reinstate" : "Suspend Account",
          confirmTone: u?.suspended ? "mint" : "coral",
          onConfirm: () => toggleUserFlag(uid, "suspended", reason)
        });
      },

      // Offers & Platform Settings
      toggleOffer: toggleOfferActive,
      confirmDeleteOffer(offerId) {
        openConfirm({
          title: "Delete Marketplace Ad?",
          message: `Permanently remove offer ${offerId} from Wayones P2P Marketplace?`,
          confirmLabel: "Delete Ad",
          confirmTone: "coral",
          onConfirm: () => deleteOffer(offerId)
        });
      },
      saveFeeConfig(e) {
        e.preventDefault();
        const fee = parseFloat(document.getElementById("cfg-fee-inp")?.value);
        if (isNaN(fee) || fee < 0 || fee > 10) { toast("Fee must be between 0% and 10%.", "error"); return; }
        savePlatformConfig({ escrowFeePct: Number(fee.toFixed(2)) }, `Global Escrow Fee updated to ${fee}%`);
      },
      toggleMaintenance() {
        const next = !state.config.maintenanceMode;
        savePlatformConfig({ maintenanceMode: next }, `Maintenance Mode turned ${next ? "ON" : "OFF"}`);
      },
      addAuthorizedEmail(e) {
        e.preventDefault();
        const inp = document.getElementById("cfg-email-inp");
        const email = (inp?.value || "").trim().toLowerCase();
        if (!email || !email.includes("@")) return;
        const list = Array.from(new Set([...(state.config.authorizedEmails || []), email]));
        savePlatformConfig({ authorizedEmails: list }, `Added ${email} to Admin Whitelist`);
      },
      removeAuthorizedEmail(email) {
        const list = (state.config.authorizedEmails || []).filter(x => x !== email);
        savePlatformConfig({ authorizedEmails: list }, `Removed ${email} from Whitelist`);
      },
      changeQuickPin(e) {
        e.preventDefault();
        const inp = document.getElementById("cfg-pin-inp");
        const pin = (inp?.value || "").trim();
        if (pin.length < 4) { toast("PIN must be at least 4 digits.", "warning"); return; }
        savePlatformConfig({ quickPin: pin }, "Quick Admin Passkey PIN updated!");
      },

      // Lightbox, Confirm, Modal & Copy
      openLightbox,
      closeLightbox,
      lightboxZoom() { state.lightbox.zoomed = !state.lightbox.zoomed; renderLightbox(); },
      lightboxRotate() { state.lightbox.rotation = ((state.lightbox.rotation || 0) + 90) % 360; renderLightbox(); },
      closeConfirm,
      runConfirm() {
        const fn = state.confirmDialog?.onConfirm;
        closeConfirm();
        if (typeof fn === "function") fn();
      },
      closeModal,
      backdropClose(e) { if (e.target === e.currentTarget) closeModal(); },
      copy: copyText
    };

    /* =========================================================================
       19. BOOTSTRAP
       ========================================================================= */
    async function init() {
      loadAdminSettingsAndLogs();
      loadSharedMirror();

      // Cross-tab BroadcastChannel + localStorage live sync with wayones-user.html
      try {
        if ("BroadcastChannel" in window) {
          bc = new BroadcastChannel(BROADCAST_NAME);
          bc.onmessage = (ev) => {
            if (ev?.data?.type === "DB_UPDATED") {
              loadSharedMirror();
              renderApp();
            }
          };
        }
      } catch {}

      window.addEventListener("storage", (ev) => {
        if (ev.key === SHARED_LS_KEY) {
          loadSharedMirror();
          renderApp();
        }
      });

      // Handle Google Auth redirect/session state
      if (auth) {
        try {
          const redir = await getRedirectResult(auth);
          if (redir?.user) completeGoogleUnlock(redir.user);
        } catch (err) {
          console.warn("Admin redirect auth notice:", err?.code || err?.message);
        }

        onAuthStateChanged(auth, (fbUser) => {
          if (fbUser && !state.unlocked && isEmailAuthorized(fbUser.email)) {
            completeGoogleUnlock(fbUser);
          }
        });
      }

      attachFirestoreListeners();
      renderApp();
    }

    init();
  </script>
