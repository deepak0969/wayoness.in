    function copyText(text, label = "Copied to clipboard!") {
      try {
        const ta = document.createElement("textarea");
        ta.value = String(text);
        ta.setAttribute("readonly", "");
        ta.style.position = "fixed";
        ta.style.top = "-9999px";
        ta.style.left = "-9999px";
        document.body.appendChild(ta);
        ta.select();
        ta.setSelectionRange(0, 999999);
        const ok = document.execCommand("copy");
        document.body.removeChild(ta);
        if (ok) {
          toast(label, "success");
          return true;
        }
      } catch {}
      toast("Unable to copy automatically.", "warning");
      return false;
    }

    function toast(msg, type = "info") {
      const host = document.getElementById("toast-host");
      if (!host) return;
      const styles = {
        success: "border-mint/55 bg-[#0A2018]/95 text-emerald-100",
        error:   "border-coral/55 bg-[#261116]/95 text-red-100",
        warning: "border-amberc/55 bg-[#251B0E]/95 text-amber-100",
        info:    "border-tealc/55 bg-[#0C1F1E]/95 text-white"
      };
      const dots = { success: "bg-mint", error: "bg-coral", warning: "bg-amberc", info: "bg-tealc" };
      const el = document.createElement("div");
      el.className = `pointer-events-auto anim-in flex items-center gap-2.5 px-4 py-3 rounded-2xl border ${styles[type] || styles.info} backdrop-blur-xl shadow-2xl text-xs sm:text-sm font-semibold`;
      el.innerHTML = `<span class="w-2 h-2 rounded-full ${dots[type] || dots.info} shrink-0"></span><span class="flex-1 leading-snug">${esc(msg)}</span>`;
      host.appendChild(el);
      setTimeout(() => {
        el.style.opacity = "0";
        el.style.transition = "opacity 0.2s ease";
        setTimeout(() => el.remove(), 220);
      }, 3600);
    }

