              <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-9 h-9 rounded-xl brand-grad flex items-center justify-center shadow-mint shrink-0">
                  ${wayonesMonogramSvg(19)}
                </div>
                ${!state.sidebarCollapsed ? `
                  <div class="min-w-0">
                    <div class="text-base font-black tracking-tight text-crisp leading-none">Way<span class="text-mint">ones</span></div>
                    <span class="inline-block mt-1 px-1.5 py-0.5 rounded bg-amberc/18 border border-amberc/40 text-amber-300 text-[9px] font-extrabold uppercase tracking-wider">Admin Console</span>
                  </div>
                ` : ""}
              </div>
              <button type="button" onclick="window.admin.toggleSidebar()" title="Toggle Sidebar" class="w-7 h-7 rounded-lg bg-panel hover:bg-borderc text-muted flex items-center justify-center text-xs shrink-0">
                ${state.sidebarCollapsed ? "»" : "«"}
              </button>
            </div>

            <nav class="flex-1 p-3 space-y-1.5">
              ${navItems.map(item => {
                const active = state.tab === item.id;
                return `
                  <button type="button" onclick="window.admin.setTab('${item.id}')" class="w-full h-11 px-3 rounded-xl flex items-center ${state.sidebarCollapsed ? "justify-center" : "justify-between"} gap-2.5 text-xs font-extrabold transition-all ${
                    active ? "bg-mint text-[#051B12] shadow-mint" : "text-muted hover:text-crisp hover:bg-panel"
                  }">
                    <span class="flex items-center gap-2.5">
                      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">${item.icon}</svg>
                      ${!state.sidebarCollapsed ? `<span>${item.label}</span>` : ""}
