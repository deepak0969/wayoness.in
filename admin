        if (Array.isArray(logs)) state.localLogs = logs;
      } catch {}
    }

    function saveAdminConfigLocal() {
      safeLSSet(ADMIN_CFG_KEY, JSON.stringify(state.config));
    }

    function loadSharedMirror() {
      try {
        const raw = safeLSGet(SHARED_LS_KEY);
        if (!raw) return;
        const d = JSON.parse(raw);
        if (d.users && typeof d.users === "object") state.localUsers = d.users;
        if (Array.isArray(d.kycRequests)) state.localKyc = d.kycRequests;
        if (Array.isArray(d.trades)) state.localTrades = d.trades;
        if (Array.isArray(d.offers)) state.localOffers = d.offers;
      } catch {}
    }

    function writeSharedMirror(mutatorFn) {
      let existing = {};
      try { existing = JSON.parse(safeLSGet(SHARED_LS_KEY) || "{}"); } catch { existing = {}; }
      existing.users = existing.users && typeof existing.users === "object" ? existing.users : {};
      existing.kycRequests = Array.isArray(existing.kycRequests) ? existing.kycRequests : [];
      existing.trades = Array.isArray(existing.trades) ? existing.trades : [];
      existing.offers = Array.isArray(existing.offers) ? existing.offers : [];

      mutatorFn(existing);
      existing.updatedAt = Date.now();
      safeLSSet(SHARED_LS_KEY, JSON.stringify(existing));

      state.localUsers = existing.users;
      state.localKyc = existing.kycRequests;
      state.localTrades = existing.trades;
      state.localOffers = existing.offers;

      if (bc) {
        try { bc.postMessage({ type: "DB_UPDATED", source: "wayones_admin", ts: Date.now() }); } catch {}
      }
    }

    async function appendAuditLog(action, target, details, severity = "info") {
      const entry = {
        id: makeId("LOG"),
        action,
        target,
        details,
        severity,
        adminEmail: state.adminUser?.email || (state.authMethod === "pin" ? "QuickPIN Admin" : "System Admin"),
        createdAt: Date.now()
      };
      state.localLogs.unshift(entry);
      if (state.localLogs.length > 150) state.localLogs = state.localLogs.slice(0, 150);
      safeLSSet(ADMIN_LOGS_KEY, JSON.stringify(state.localLogs));

      if (db && !String(target).includes("SAMPLE")) {
        try {
          await setDoc(doc(db, "adminLogs", entry.id), {
            ...entry,
            serverAt: serverTimestamp()
          });
        } catch (err) {
          console.warn("Audit log Firestore write notice:", err?.code || err?.message);
        }
      }
    }

    function markFirestoreLive() {
      if (state.firestoreStatus !== "live") {
        state.firestoreStatus = "live";
        state.firestoreErrorMsg = "";
        renderApp();
      }
    }

    function markFirestoreError(err) {
      state.firestoreStatus = "error";
      state.firestoreErrorMsg = err?.code === "permission-denied"
        ? "Firestore Security Rules are blocking reads. Set your Firestore Rules to test mode or allow admin access."
        : (err?.message || "Unable to reach Firestore. Operating with local BroadcastChannel mirror.");
      renderApp();
    }

    function attachFirestoreListeners() {
      if (!db) {
        markFirestoreError({ message: "Firebase SDK unavailable." });
        return;
      }

      const safeListen = (colName, onData) => {
        try {
          const unsub = onSnapshot(
            collection(db, colName),
            (snap) => {
              markFirestoreLive();
              const obj = {};
              snap.forEach(d => { obj[d.id] = { id: d.id, ...d.data() }; });
              onData(obj);
              renderApp();
            },
            (err) => {
              console.warn(`Firestore listener [${colName}]:`, err?.code || err?.message);
              if (err?.code === "permission-denied" || err?.code === "unavailable") {
                markFirestoreError(err);
              }
            }
          );
          unsubs.push(unsub);
        } catch (err) {
          console.warn(`Could not subscribe to ${colName}:`, err);
        }
      };

      safeListen("users", (obj) => { state.fsUsers = obj; });
      safeListen("kyc_submissions", (obj) => { state.fsKycA = obj; });
      safeListen("kycSubmissions", (obj) => { state.fsKycB = obj; });
      safeListen("trades", (obj) => { state.fsTrades = obj; });
      safeListen("offers", (obj) => { state.fsOffers = obj; });
      safeListen("adminLogs", (obj) => {
        state.fsLogs = Object.values(obj).sort((a, b) => toMillis(b.createdAt || b.serverAt) - toMillis(a.createdAt || a.serverAt));
      });

      // Platform config doc
      try {
        const unsubCfg = onSnapshot(
          doc(db, "config", "platform"),
          (snap) => {
            markFirestoreLive();
            if (snap.exists()) {
              const d = snap.data();
              state.config = {
                ...state.config,
                escrowFeePct: typeof d.escrowFeePct === "number" ? d.escrowFeePct : state.config.escrowFeePct,
                maintenanceMode: typeof d.maintenanceMode === "boolean" ? d.maintenanceMode : state.config.maintenanceMode,
                authorizedEmails: Array.isArray(d.authorizedEmails) ? d.authorizedEmails : state.config.authorizedEmails,
                quickPin: d.quickPin || state.config.quickPin
              };
              saveAdminConfigLocal();
              renderApp();
            }
          },
          () => {}
        );
        unsubs.push(unsubCfg);
      } catch {}
    }

