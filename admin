        mirror.offers = mirror.offers.map(o => o.id === offerId ? { ...o, isActive: nextActive } : o);
      });

      if (db) {
        try { await setDoc(doc(db, "offers", offerId), { isActive: nextActive }, { merge: true }); } catch {}
      }
      await appendAuditLog("OFFER_MODERATION", offerId, `Offer ${nextActive ? "resumed" : "paused"}`, "info");
      toast(`Offer ${offerId} ${nextActive ? "resumed" : "paused"}.`, "success");
      renderApp();
    }

    async function deleteOffer(offerId) {
      const offer = getAllOffers().find(o => o.id === offerId);
      if (!offer) return;

      if (offer.isSample) {
        state.sampleOffers = state.sampleOffers.filter(o => o.id !== offerId);
        toast("[SAMPLE] Offer deleted.", "warning");
        renderApp();
        return;
      }

      writeSharedMirror((mirror) => {
        mirror.offers = mirror.offers.filter(o => o.id !== offerId);
      });

      if (db) {
        try { await deleteDoc(doc(db, "offers", offerId)); } catch {}
      }
      await appendAuditLog("OFFER_DELETED", offerId, `Removed ${offer.crypto}/${offer.fiat} ad by ${offer.traderName}`, "error");
      toast(`Offer ${offerId} removed permanently.`, "warning");
      renderApp();
    }

    async function savePlatformConfig(patch, toastMsg = "Platform settings saved!") {
      state.config = { ...state.config, ...patch };
      saveAdminConfigLocal();
      if (db) {
        try {
          await setDoc(doc(db, "config", "platform"), {
            ...state.config,
            updatedAt: serverTimestamp()
          }, { merge: true });
        } catch (err) { console.warn("Config Firestore save notice:", err); }
      }
      await appendAuditLog("PLATFORM_CONFIG", "config/platform", JSON.stringify(patch), "info");
      toast(toastMsg, "success");
      renderApp();
    }

