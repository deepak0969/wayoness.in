       ========================================================================= */
    function isEmailAuthorized(email) {
      const list = (state.config.authorizedEmails || []).map(e => String(e).trim().toLowerCase()).filter(Boolean);
      if (!list.length) return true; // If no whitelist configured yet, any Google admin login is allowed
      return list.includes(String(email || "").trim().toLowerCase());
    }

    async function handleGoogleAdminSignIn() {
      if (!auth || !googleProvider) {
        state.authError = "Firebase Auth SDK is initializing. Try Quick Admin PIN or refresh.";
        renderApp();
        return;
      }
      state.authLoading = true;
      state.authError = "";
      renderApp();

      try {
        const res = await signInWithPopup(auth, googleProvider);
        state.authLoading = false;
        if (res?.user) {
          completeGoogleUnlock(res.user);
        }
      } catch (err) {
        const code = err?.code || "";
        if (code === "auth/popup-blocked" || code === "auth/operation-not-supported-in-this-environment") {
          try {
            await signInWithRedirect(auth, googleProvider);
            return;
          } catch (rErr) {
            handleAuthFailure(rErr);
          }
        } else {
          handleAuthFailure(err);
        }
      }
    }

    function handleAuthFailure(err) {
      state.authLoading = false;
      const code = err?.code || "";
      if (code === "auth/unauthorized-domain") {
        state.authError = "Google Sign-In activates once hosted on your Firebase domain (wayones-595fb.web.app). Use Quick Passkey PIN (2026) below to unlock immediately here.";
      } else if (code === "auth/popup-closed-by-user" || code === "auth/cancelled-popup-request") {
        state.authError = "Google sign-in popup was closed. Tap again or use Quick Passkey PIN.";
      } else {
        state.authError = err?.message || "Unable to complete Google Sign-In.";
      }
      renderApp();
    }

    function completeGoogleUnlock(fbUser) {
      if (!isEmailAuthorized(fbUser.email)) {
        state.authError = `Access denied for ${fbUser.email}. This email is not in your Authorized Admin Whitelist.`;
        toast("Unauthorized Google account blocked.", "error");
        try { signOut(auth); } catch {}
        renderApp();
        return;
      }
      state.unlocked = true;
      state.authMethod = "google";
      state.adminUser = {
        uid: fbUser.uid,
        email: fbUser.email || "admin@wayones.com",
        name: fbUser.displayName || "Wayones Admin",
        photoURL: fbUser.photoURL || ""
      };
      state.authError = "";
      appendAuditLog("ADMIN_LOGIN", "Console", `Signed in via Google (${state.adminUser.email})`, "info");
      toast(`Admin Console unlocked (${state.adminUser.email})`, "success");
      renderApp();
    }

    function unlockWithPin(e) {
      if (e) e.preventDefault();
      const inp = document.getElementById("admin-pin-inp");
      const val = (inp ? inp.value : state.pinInput).trim();
