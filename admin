      writeSharedMirror((mirror) => {
        const existing = mirror.users[uid] || { uid, name: u.name, email: u.email, balances: {} };
        existing.balances = { ...(existing.balances || {}), [coin]: next };
        mirror.users[uid] = existing;
      });

      if (db) {
        try {
          const nextBals = { ...(u.balances || {}), [coin]: next };
          await setDoc(doc(db, "users", uid), { balances: nextBals }, { merge: true });
        } catch (err) { console.warn("Balance Firestore err:", err); }
