    /* =========================================================================
       5. MERGED DATA ACCESSORS (FIRESTORE + LOCAL MIRROR + OPTIONAL [SAMPLE])
       ========================================================================= */
    function getAllUsers() {
      const map = new Map();
      // 1. Local mirror users
      Object.values(state.localUsers || {}).forEach(u => {
        if (!u) return;
        const uid = u.uid || u.id;
        if (!uid) return;
        map.set(uid, normalizeUserObj(uid, u));
      });
      // 2. Live Firestore users (takes precedence over local mirror)
      Object.entries(state.fsUsers || {}).forEach(([uid, u]) => {
        const existing = map.get(uid) || {};
        map.set(uid, normalizeUserObj(uid, { ...existing, ...u }));
      });
      // 3. Optional tagged [SAMPLE] users
      if (state.sampleMode) {
        Object.entries(state.sampleUsers || {}).forEach(([uid, u]) => {
          map.set(uid, normalizeUserObj(uid, { ...u, isSample: true }));
        });
      }
      return Array.from(map.values()).sort((a, b) => toMillis(b.lastLoginAt) - toMillis(a.lastLoginAt));
    }

    function normalizeUserObj(uid, raw) {
      const kycData = raw.kycData || {};
      return {
        uid,
        name: raw.name || raw.username || raw.displayName || (raw.email ? raw.email.split("@")[0] : "Wayones User"),
        email: raw.email || "",
        photoURL: raw.photoURL || "",
        kycStatus: normalizeKycStatus(raw.kycStatus || kycData.status),
        kycRejectionReason: raw.kycRejectionReason || raw.kycRejectReason || raw.rejectionReason || kycData.rejectionReason || "",
        kycData,
        verifiedMerchant: Boolean(raw.verifiedMerchant),
        suspended: Boolean(raw.suspended),
        suspendReason: raw.suspendReason || "",
        balances: { USDT: 0, USDC: 0, BTC: 0, ETH: 0, BNB: 0, SOL: 0, TRX: 0, TON: 0, ...(raw.balances || {}) },
        lastLoginAt: raw.lastLoginAt || raw.createdAt || Date.now(),
        isSample: Boolean(raw.isSample)
      };
    }

    function getAllKycRecords() {
      const map = new Map();
      const usersByUid = new Map(getAllUsers().map(u => [u.uid, u]));

      const upsertKyc = (uid, rec, isSample = false) => {
        if (!uid) return;
        const prev = map.get(uid) || {};
        const u = usersByUid.get(uid) || {};
        const status = normalizeKycStatus(rec.status || u.kycStatus || prev.status || "pending");
        map.set(uid, {
          id: rec.id || prev.id || `KYC-${uid.slice(0, 6).toUpperCase()}`,
          uid,
          name: rec.name || u.name || prev.name || rec.fullName || "Wayones Trader",
          fullName: rec.fullName || prev.fullName || rec.name || u.name || "—",
          email: rec.email || u.email || prev.email || "—",
          photoURL: rec.photoURL || u.photoURL || prev.photoURL || "",
          country: rec.country || prev.country || "India",
          docType: rec.docType || rec.idType || prev.docType || "National ID",
          docNumber: rec.docNumber || rec.idNumber || prev.docNumber || "—",
          dob: rec.dob || prev.dob || "—",
          frontImg: rec.frontImg || rec.frontImage || prev.frontImg || "",
          backImg: rec.backImg || rec.backImage || prev.backImg || "",
          selfieImg: rec.selfieImg || rec.selfieImage || prev.selfieImg || "",
          status,
          rejectionReason: rec.rejectionReason || rec.kycRejectionReason || rec.kycRejectReason || rec.reviewNotes || u.kycRejectionReason || prev.rejectionReason || "",
          submittedAt: rec.submittedAt || prev.submittedAt || u.lastLoginAt || Date.now(),
          verifiedAt: rec.verifiedAt || prev.verifiedAt || null,
          isSample: Boolean(isSample || rec.isSample || u.isSample)
        });
      };

      // 1. Nested kycData inside users/{uid}
      usersByUid.forEach((u, uid) => {
        const kd = u.kycData || {};
        const hasNestedDocs = Boolean(kd.frontImage || kd.frontImg || kd.idNumber || kd.docNumber || kd.idType || kd.docType);
        if (hasNestedDocs || u.kycStatus !== "unverified") {
          upsertKyc(uid, { ...kd, status: u.kycStatus, rejectionReason: u.kycRejectionReason }, u.isSample);
        }
      });

      // 2. Local mirror kycRequests
      (state.localKyc || []).forEach(k => {
        if (k && (k.uid || k.userId)) upsertKyc(k.uid || k.userId, k, false);
      });

      // 3. Firestore kyc_submissions & kycSubmissions
      Object.entries(state.fsKycA || {}).forEach(([docId, k]) => upsertKyc(k.uid || k.userId || docId, k, false));
      Object.entries(state.fsKycB || {}).forEach(([docId, k]) => upsertKyc(k.uid || k.userId || docId, k, false));

      // 4. Optional [SAMPLE] KYCs
      if (state.sampleMode) {
        (state.sampleKyc || []).forEach(k => upsertKyc(k.uid, k, true));
      }

      return Array.from(map.values()).sort((a, b) => toMillis(b.submittedAt) - toMillis(a.submittedAt));
    }

    function getAllTrades() {
      const map = new Map();
      (state.localTrades || []).forEach(t => { if (t && t.id) map.set(t.id, normalizeTradeObj(t.id, t)); });
      Object.entries(state.fsTrades || {}).forEach(([id, t]) => {
        const prev = map.get(id) || {};
        map.set(id, normalizeTradeObj(id, { ...prev, ...t }));
      });
      if (state.sampleMode) {
        (state.sampleTrades || []).forEach(t => map.set(t.id, normalizeTradeObj(t.id, { ...t, isSample: true })));
      }
      return Array.from(map.values()).sort((a, b) => toMillis(b.createdAt) - toMillis(a.createdAt));
    }

