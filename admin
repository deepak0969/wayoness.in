    /* =========================================================================
       16. FULLSCREEN LIGHTBOX (ZOOM + 90° ROTATE) & IN-APP CONFIRM DIALOG
       ========================================================================= */
    let lightboxMeta = {};
    function openLightbox(title, src, meta = {}) {
      lightboxMeta = meta || {};
      state.lightbox = { open: true, title, src, zoomed: false, rotation: 0 };
      renderLightbox();
    }

    function closeLightbox() {
      state.lightbox.open = false;
      const root = document.getElementById("lightbox-root");
      if (root) root.innerHTML = "";
    }

    function renderLightbox() {
      const root = document.getElementById("lightbox-root");
      if (!root) return;
      const lb = state.lightbox;
      if (!lb.open) { root.innerHTML = ""; return; }

      const scale = lb.zoomed ? 1.85 : 1;
      const rot = lb.rotation || 0;

      root.innerHTML = `
        <div class="fixed inset-0 z-[120] bg-black/95 backdrop-blur-md flex flex-col">
          <!-- Lightbox Toolbar -->
          <div class="px-4 py-3 bg-card/95 border-b border-borderc flex items-center justify-between gap-2">
            <div class="text-xs sm:text-sm font-extrabold text-crisp truncate">${esc(lb.title)}</div>
            <div class="flex items-center gap-2 shrink-0">
              <button type="button" onclick="window.admin.lightboxZoom()" class="h-9 px-3 rounded-xl bg-panel border border-borderc hover:border-mint text-xs font-bold text-crisp">
                ${lb.zoomed ? "Zoom 1x" : "Zoom 1.8x 🔍"}
              </button>
              <button type="button" onclick="window.admin.lightboxRotate()" class="h-9 px-3 rounded-xl bg-panel border border-borderc hover:border-mint text-xs font-bold text-mint">
                Rotate 90° ↻
              </button>
              <button type="button" onclick="window.admin.closeLightbox()" class="h-9 w-9 rounded-xl bg-coral text-white font-black text-sm flex items-center justify-center">✕</button>
            </div>
          </div>

          <!-- Image Viewport -->
          <div class="flex-1 overflow-auto flex items-center justify-center p-6" onclick="window.admin.closeLightbox()">
            <div onclick="event.stopPropagation(); window.admin.lightboxZoom()" class="cursor-zoom-in transition-transform duration-200 ease-out flex items-center justify-center" style="transform: scale(${scale}) rotate(${rot}deg);">
              ${renderDocumentVisual(lb.src, lb.title, lightboxMeta, true)}
            </div>
          </div>
        </div>
      `;
    }

    function openConfirm({ title, message, confirmLabel = "Confirm", confirmTone = "mint", onConfirm }) {
      state.confirmDialog = { title, message, confirmLabel, confirmTone, onConfirm };
      const root = document.getElementById("confirm-root");
      if (!root) return;
      const btnCls = confirmTone === "coral"
        ? "bg-coral hover:bg-red-500 text-white"
        : "bg-mint hover:bg-mint-hover text-[#051B12] shadow-mint";

      root.innerHTML = `
        <div class="fixed inset-0 z-[140] flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm" onclick="window.admin.closeConfirm()">
          <div class="anim-in w-full max-w-sm bg-card border border-borderc rounded-3xl p-5 space-y-4 shadow-2xl" onclick="event.stopPropagation()">
            <h3 class="text-base font-extrabold text-crisp">${esc(title)}</h3>
            <p class="text-xs sm:text-sm text-muted leading-relaxed">${esc(message)}</p>
            <div class="flex items-center gap-2 pt-1">
              <button type="button" onclick="window.admin.closeConfirm()" class="flex-1 h-11 rounded-xl bg-panel border border-borderc text-xs font-bold text-crisp">Cancel</button>
              <button type="button" onclick="window.admin.runConfirm()" class="flex-1 h-11 rounded-xl font-extrabold text-xs transition-all ${btnCls}">${esc(confirmLabel)}</button>
            </div>
          </div>
        </div>
      `;
    }

    function closeConfirm() {
      state.confirmDialog = null;
      const root = document.getElementById("confirm-root");
      if (root) root.innerHTML = "";
    }

    /* =========================================================================
