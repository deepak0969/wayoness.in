    function tradeStatusBadge(status, disputeStatus = "") {
      if (status === "disputed") return `<span class="px-2.5 py-0.5 rounded-full bg-coral/20 border border-coral/50 text-red-300 text-[10px] font-extrabold uppercase">Disputed</span>`;
      if (status === "paid") return `<span class="px-2.5 py-0.5 rounded-full bg-tealc/20 border border-tealc/45 text-tealc text-[10px] font-extrabold uppercase">Fiat Paid</span>`;
      if (status === "escrow_locked") return `<span class="px-2.5 py-0.5 rounded-full bg-amberc/15 border border-amberc/45 text-amber-300 text-[10px] font-extrabold uppercase">Escrow Locked</span>`;
      if (status === "released") return `<span class="px-2.5 py-0.5 rounded-full bg-mint/15 border border-mint/45 text-mint text-[10px] font-extrabold uppercase">${disputeStatus === "resolved_buyer" ? "Resolved → Buyer" : "Released ✓"}</span>`;
      return `<span class="px-2.5 py-0.5 rounded-full bg-panel border border-borderc text-muted text-[10px] font-extrabold uppercase">${disputeStatus === "resolved_seller" ? "Refunded → Seller" : "Cancelled"}</span>`;
    }

