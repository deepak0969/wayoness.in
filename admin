    async function executeDisputeVerdict(tradeId, verdict) {
      const t = getAllTrades().find(x => x.id === tradeId);
      if (!t) return;

      let nextStatus = t.status;
      let disputeStatus = t.disputeStatus || "";
      let systemNote = "";
      let logAction = "";
      let logSev = "success";

      if (verdict === "release_buyer") {
        nextStatus = "released";
        disputeStatus = "resolved_buyer";
        systemNote = `BINDING VERDICT: Escrow released to Buyer (${t.buyerName}). ${fmtCrypto(t.cryptoAmount, t.crypto)} ${t.crypto} credited after payment verification.`;
        logAction = "DISPUTE_RELEASE_BUYER";
      } else if (verdict === "refund_seller") {
        nextStatus = "cancelled";
        disputeStatus = "resolved_seller";
        systemNote = `BINDING VERDICT: Escrow refunded to Seller (${t.sellerName}). ${fmtCrypto(t.cryptoAmount, t.crypto)} ${t.crypto} returned to Seller wallet.`;
        logAction = "DISPUTE_REFUND_SELLER";
        logSev = "warning";
      } else {
        systemNote = `EVIDENCE REQUEST: Wayones Arbitrator has placed this trade on hold and requested updated bank statement / video proof from both parties within 30 minutes.`;
        logAction = "DISPUTE_HOLD_EVIDENCE";
        logSev = "info";
      }

      const updatedMsgs = [
        ...(t.messages || []),
        {
          id: makeId("VRD"),
          senderRole: "admin",
          senderName: "[Wayones Arbitrator]",
          text: systemNote,
          createdAt: Date.now()
        }
      ];

      if (t.isSample) {
        state.sampleTrades = state.sampleTrades.map(x => x.id === tradeId ? {
          ...x,
          status: nextStatus,
          disputeStatus,
          messages: updatedMsgs,
          resolvedAt: verdict !== "hold" ? Date.now() : x.resolvedAt
        } : x);

        if (verdict === "release_buyer" && state.sampleUsers[t.buyerUid]) {
          const b = state.sampleUsers[t.buyerUid];
          b.balances = b.balances || {};
          b.balances[t.crypto] = Number(((b.balances[t.crypto] || 0) + t.cryptoAmount).toFixed(6));
        } else if (verdict === "refund_seller" && state.sampleUsers[t.sellerUid]) {
          const s = state.sampleUsers[t.sellerUid];
          s.balances = s.balances || {};
          s.balances[t.crypto] = Number(((s.balances[t.crypto] || 0) + t.cryptoAmount).toFixed(6));
        }

        await appendAuditLog(logAction, `[SAMPLE] ${tradeId}`, systemNote, logSev);
        renderTradeInspectModal(tradeId);
        toast("Verdict applied to [SAMPLE] dispute case!", logSev);
        renderApp();
        return;
      }

      // Live update in local mirror + BroadcastChannel
      writeSharedMirror((mirror) => {
        const idx = mirror.trades.findIndex(x => x.id === tradeId);
        if (idx >= 0) {
          mirror.trades[idx] = {
            ...mirror.trades[idx],
            status: nextStatus,
            disputeStatus,
            messages: updatedMsgs,
            resolvedAt: verdict !== "hold" ? Date.now() : mirror.trades[idx].resolvedAt
          };
        }
        const creditUid = verdict === "release_buyer" ? t.buyerUid : verdict === "refund_seller" ? t.sellerUid : null;
        if (creditUid && mirror.users[creditUid]) {
          const bals = mirror.users[creditUid].balances || {};
          bals[t.crypto] = Number(((bals[t.crypto] || 0) + t.cryptoAmount).toFixed(6));
          mirror.users[creditUid].balances = bals;
        }
      });

      // Live update in Firestore
      if (db) {
        try {
          await setDoc(doc(db, "trades", tradeId), {
            status: nextStatus,
            disputeStatus,
            messages: updatedMsgs,
            resolvedAt: verdict !== "hold" ? serverTimestamp() : null
          }, { merge: true });
        } catch (err) { console.warn("Trade verdict Firestore err:", err); }

        const creditUid = verdict === "release_buyer" ? t.buyerUid : verdict === "refund_seller" ? t.sellerUid : null;
        if (creditUid && !creditUid.startsWith("tr_")) {
          try {
            const uSnap = await getDoc(doc(db, "users", creditUid));
            const curBals = uSnap.exists() && uSnap.data().balances ? { ...uSnap.data().balances } : {};
            curBals[t.crypto] = Number(((Number(curBals[t.crypto]) || 0) + t.cryptoAmount).toFixed(6));
            await setDoc(doc(db, "users", creditUid), { balances: curBals }, { merge: true });
          } catch (err) { console.warn("User balance credit err:", err); }
        }
      }

      await appendAuditLog(logAction, tradeId, systemNote, logSev);
      renderTradeInspectModal(tradeId);
      toast(`Arbitration ruling applied to ${tradeId}!`, logSev);
      renderApp();
    }

